<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The API, Reverb and YouTube. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hosting Present's remote: phones on the same network connect in. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Importing ChordPro/backups and saving exported PDFs. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- flutter_secure_storage keeps the session token in the Keychain. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)pro.daloy.app</string>
	</array>
	<!-- No associated-domains here: personal teams can't sign it, so
	     Universal Links only work in Release builds. -->
</dict>
</plist>
