<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The API, Reverb and YouTube. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hosting Present's remote: phones on the same network connect in. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Importing ChordPro/backups and saving exported PDFs. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- flutter_secure_storage keeps the session token in the Keychain. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)pro.daloy.app</string>
	</array>
	<!-- TODO: put back for the App Store once on a paid team (personal teams
	     can't sign it):
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:daloy.pro</string>
	</array>
	-->
</dict>
</plist>
