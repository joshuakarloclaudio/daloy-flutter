<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: invite, join and reset-password links on daloy.pro
	     open the app. Served from daloy.pro/.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:daloy.pro</string>
	</array>
	<!-- The home-screen widget (DaloyWidget) reads the next line-ups here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.pro.daloy.app</string>
	</array>
</dict>
</plist>
